+macro_rules! log_error {
+    (target: $target:expr, $($arg:tt)*) => {{
+        tracing::error!(target: $target, $($arg)*);
+        if let Ok(mut file) = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open("/tmp/cosmic-applet-audio-sound.log")
+        {
+            let msg = format!($($arg)*);
+            let _ = writeln!(file, "{}", msg);
+        }
+    }};
+    ($($arg:tt)*) => {{
